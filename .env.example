# Frontend (optional — leave unset for local dev with Vite proxy,
# or for static deploys that only use the offline shell)
# VITE_TERM_WS_URL=wss://term.kylewelsh.dev/ws
# VITE_TERM_HTTP_URL=https://term.kylewelsh.dev
# v86 guest internet (wsproxy). Default is the copy.sh public relay.
# VITE_V86_RELAY_URL=wss://relay.widgetry.org/

# Backend (server/)
# PORT=8787
# IMAGE=busybox:latest
# CONTAINER_BIN=container
# MAX_SESSIONS=4
# MAX_PER_IP=2
# IDLE_MS=600000
# MAX_LIFE_MS=1800000
# CPUS=1
# MEMORY=256m
# NETWORK=none
