{
  "name": "kylewelsh.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "fetch:v86": "node scripts/fetch-v86-assets.mjs",
    "predev": "node scripts/fetch-v86-assets.mjs",
    "prebuild": "node scripts/fetch-v86-assets.mjs",
    "dev": "vite",
    "dev:server": "npm run dev -w @kylewelsh.dev/server",
    "dev:all": "npm run dev & npm run dev:server",
    "build": "vue-tsc --noEmit && vite build",
    "build:server": "npm run build -w @kylewelsh.dev/server",
    "preview": "vite preview",
    "start:server": "npm run start -w @kylewelsh.dev/server"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "v86": "^0.5.432",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.4"
  }
}
